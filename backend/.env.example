# Local API settings
PORT=3000
FRONTEND_URL=http://localhost:5173
UNIVERSITY_EMAIL_DOMAIN=unibz.it

# Replace this with a long random value outside local development.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_MS=86400000

# Optional; defaults to backend/data/uniswap.sqlite.
# DATABASE_PATH=data/uniswap.sqlite

# Set to true only when the API is served over HTTPS.
COOKIE_SECURE=false
